#: src/pages/login.tsx
msgid "Sign in"
msgstr "Sign in"

#: worker/lib/http.ts
msgid "Not found."
msgstr "Not found."

#: src/pages/login.tsx
msgid "<0>Tip:</0> In the browser menu, choose <1>Add to Home screen</1> or <2>Install app</2>. Then {club} starts like an app."
msgstr "<0>Tip:</0> In the browser menu, choose <1>Add to Home screen</1> or <2>Install app</2>. Then {club} starts like an app."

#: src/pages/login.tsx
msgid "Welcome"
msgstr "Welcome"

#: worker/lib/http.ts
msgid "Invalid JSON."
msgstr "Invalid JSON."

#: src/pages/login.tsx
msgid "We send a code to the e-mail address you gave for your access."
msgstr "We send a code to the e-mail address you gave for your access."

#: src/pages/login.tsx
msgid "{club} is an internal club app. If no code arrives, this address is not on file. Access is only available through an invitation from your coach."
msgstr "{club} is an internal club app. If no code arrives, this address is not on file. Access is only available through an invitation from your coach."

#: src/pages/login.tsx
msgid "This browser does not support passkeys. Please use a current smartphone with Safari or Chrome."
msgstr "This browser does not support passkeys. Please use a current smartphone with Safari or Chrome."

#: src/pages/login.tsx
msgid "The passkey is the <0>safest way to sign in</0>: Face ID, fingerprint or your screen lock, without a password."
msgstr "The passkey is the <0>safest way to sign in</0>: Face ID, fingerprint or your screen lock, without a password."

#: src/pages/login.tsx
msgid "Code by e-mail"
msgstr "Code by e-mail"

#: worker/lib/http.ts
msgid "Invalid input."
msgstr "Invalid input."

#: src/pages/login.tsx
msgid "Sign in with passkey"
msgstr "Sign in with passkey"

#: src/pages/login.tsx
msgid "<0>Install as an app:</0> In Safari, tap <1>Share</1> at the bottom, then <2>Add to Home Screen</2>. Only then do notifications work on the iPhone."
msgstr "<0>Install as an app:</0> In Safari, tap <1>Share</1> at the bottom, then <2>Add to Home Screen</2>. Only then do notifications work on the iPhone."

#: src/pages/login.tsx
msgid "Send code"
msgstr "Send code"

#: worker/lib/http.ts
msgid "You do not have permission to do this."
msgstr "You do not have permission to do this."

#: src/pages/login.tsx
