{
  "name": "kabine",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "imports": {
    "#i18n": "./worker/i18n.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "journey": "playwright test -c playwright.journey.config.ts",
    "screenshots": "KABINE_SHOTS_LOCALE=de playwright test -c playwright.screenshots.config.ts && KABINE_SHOTS_LOCALE=en playwright test -c playwright.screenshots.config.ts",
    "check": "npm run typecheck && npm run test && npm run i18n:check",
    "new": "node scripts/new.mjs",
    "cf-typegen": "wrangler types --strict-vars=false worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/demo.sql",
    "db:reset:local": "node scripts/reset-local.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:demo": "node scripts/deploy.mjs --env demo",
    "site:build": "node scripts/site-build.mjs",
    "site:og": "node scripts/site-og.mjs",
    "site:dev": "node scripts/site-build.mjs --preview && wrangler dev --config site/wrangler.jsonc --port 8790",
    "site:deploy": "node scripts/site-build.mjs && wrangler deploy --config site/wrangler.jsonc",
    "demo:reset": "node scripts/demo-reset.mjs",
    "admin:link": "node scripts/admin-link.mjs",
    "maintenance:on": "node scripts/maintenance.mjs on",
    "maintenance:off": "node scripts/maintenance.mjs off",
    "maintenance:status": "node scripts/maintenance.mjs status",
    "i18n": "lingui extract --clean && node tools/i18n-fill.mjs",
    "i18n:check": "lingui extract --clean && node tools/i18n-fill.mjs --check"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@lingui/core": "^5.9.5",
    "@lingui/react": "^5.9.5",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.12",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@lingui/babel-plugin-lingui-macro": "^5.9.5",
    "@lingui/cli": "^5.9.5",
    "@lingui/conf": "^5.9.5",
    "@lingui/format-po": "^5.9.5",
    "@lingui/vite-plugin": "^5.9.5",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.18.0",
    "marked": "^18.1.1",
    "pofile": "^1.1.4",
    "preact-render-to-string": "^6.6.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true
  },
  "license": "AGPL-3.0-only",
  "description": "Team app for sports clubs: events, attendance, squads, chat, push, helper duties. One installation per club on Cloudflare.",
  "cloudflare": {
    "bindings": {
      "ADMIN_BOOTSTRAP_TOKEN": {
        "description": "A password you choose (at least 16 characters); you need it once to become the first admin. **After the deploy, first give the app the club's address**, e.g. `app.your-club.org` (*Workers & Pages → this Worker → Settings → Domains & Routes → Add → Custom domain*; the club's domain must be managed in Cloudflare), because passkeys are bound to it. Then open that address: the app asks for this password and sets up the first admin. [Step by step](https://github.com/witscher/kabine/blob/main/docs/install.md)"
      },
      "DB": {
        "description": "The club's data (D1 database)."
      },
      "KV": {
        "description": "Club logo, the maintenance switch and short-lived counters."
      },
      "PUSH_QUEUE": {
        "description": "Queue for push notifications."
      },
      "EMAIL": {
        "description": "Optional: Cloudflare Email Sending. Alternatively enter the club's SMTP server in the setup wizard."
      }
    }
  }
}
