{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Kabine: one installation per club, in the club's own Cloudflare account.
  // The "Deploy to Cloudflare" button provisions D1, KV, the queue and the Durable Objects.
  "name": "kabine",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-20",
  // AsyncLocalStorage: the language of the current request or recipient (worker/i18n.ts)
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages too (not the hashed build files), so a plain http:// request is redirected to https://
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "observability": { "enabled": true },
  // No "vars": the app takes its address from the request and the mail sender from the setup wizard,
  // so the "Deploy to Cloudflare" button asks nothing beyond the setup password. Optional variables
  // (RP_ID, ORIGIN, MAIL_FROM) are described in docs/operation.md.
  // Cloudflare Email Sending (optional). Alternatively the club enters an SMTP server in the setup wizard.
  "send_email": [{ "name": "EMAIL" }],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "kabine", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "KV" }],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT", "class_name": "ChatRoom" },
      { "name": "DUTY_HUB", "class_name": "DutyHub" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom", "DutyHub"] }],
  "queues": {
    "producers": [{ "binding": "PUSH_QUEUE", "queue": "kabine-push" }],
    "consumers": [{ "queue": "kabine-push", "max_batch_size": 20, "max_batch_timeout": 5, "max_retries": 3 }]
  },
  // Workers AI: only used by the optional "AI list import" module, when an admin asks it to (modules/ai-import).
  // Without that module nothing is sent and nothing is billed.
  "ai": { "binding": "AI" },
  // One run per hour; worker/cron.ts decides what is due.
  "triggers": { "crons": ["17 * * * *"] },
  // Public demo on handball.kabine.dev: own database, KV, queue and Durable Objects, so it never touches
  // anything else. Starts over every night at 3:00 Berlin time (worker/demo/reset.ts).
  // Build and deploy: npm run deploy:demo. Secret: DEMO_RESET_TOKEN (manual reset, see docs/operation.md).
  "env": {
    "demo": {
      "name": "kabine-demo",
      "vars": { "RP_ID": "handball.kabine.dev", "ORIGIN": "https://handball.kabine.dev", "APP_ENV": "demo", "MAIL_FROM": "" },
      "workers_dev": false,
      "send_email": [{ "name": "EMAIL" }],
      "routes": [{ "pattern": "handball.kabine.dev", "custom_domain": true }],
      "d1_databases": [
        { "binding": "DB", "database_name": "kabine-demo", "database_id": "6b179e9d-95b7-4748-93ae-056c30d4940d", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "77deaed831fb4f2e8379a274cd3cce7b" }],
      "durable_objects": {
        "bindings": [
          { "name": "CHAT", "class_name": "ChatRoom" },
          { "name": "DUTY_HUB", "class_name": "DutyHub" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom", "DutyHub"] }],
      "queues": {
        "producers": [{ "binding": "PUSH_QUEUE", "queue": "kabine-demo-push" }],
        "consumers": [{ "queue": "kabine-demo-push", "max_batch_size": 20, "max_batch_timeout": 5, "max_retries": 3 }]
      },
      // On the hour; worker/index.ts resets the demo when it is 3:00 in Berlin
      "triggers": { "crons": ["0 * * * *"] }
    }
  }
}
